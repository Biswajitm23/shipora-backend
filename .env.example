# Copy to .env and adjust as needed. Never commit .env.
SECRET_KEY=dev-insecure-key-change-me-for-local-use-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://shipora:postgres@localhost:5432/shipora

# Local development: filemail:// keeps every email as a file in sent_emails/ (the
# local test mailbox); consolemail:// prints it to the server log instead. Neither
# sends anything to a real inbox, and the website says so. With DEBUG off they
# count as "email not sent".
# Real delivery: smtp://user:password@smtp.example.com:587/?tls=True
EMAIL_URL=filemail://
# Seconds to wait for the mail server before giving up.
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Shipora <no-reply@shipora.local>

# The website; links in emails point here.
FRONTEND_URL=http://localhost:3000

# Seconds an account waits before it can be sent another verification email.
EMAIL_VERIFICATION_RESEND_COOLDOWN=60
